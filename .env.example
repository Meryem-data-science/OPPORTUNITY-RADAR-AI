# Local development defaults. The application does not load this file automatically.
OPPORTUNITY_RADAR_ENV=development
DATABASE_BACKEND=sqlite
SQLITE_DATABASE_PATH=./data/opportunity-radar.db

# Required only when DATABASE_BACKEND=turso. Supply secrets through the environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gmail OAuth files stay local and are ignored by Git.
GMAIL_OAUTH_CLIENT_SECRET_PATH=.secrets/gmail-oauth-client.json
GMAIL_TOKEN_PATH=.secrets/gmail-token.json
GMAIL_ALERT_QUERY=label:Opportunity-Radar
# Optional Gmail search used only by the read-only LinkedIn alert probe.
GMAIL_LINKEDIN_ALERT_QUERY=

# Web Push (Phase 5.3A opt-in). Only the PUBLIC application server key is read
# here and only it is ever served to a browser. The matching VAPID PRIVATE key
# belongs to delivery, is never committed, and is not read by this phase.
WEB_PUSH_VAPID_PUBLIC_KEY=

# Server-side base URL of the Python API. The Next app proxies the browser to it
# from its own origin, so this must never become a NEXT_PUBLIC_ variable.
OPPORTUNITY_API_BASE_URL=http://127.0.0.1:8000
