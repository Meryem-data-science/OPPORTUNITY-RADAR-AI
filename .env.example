# Local development defaults. The application does not load this file automatically.
OPPORTUNITY_RADAR_ENV=development
DATABASE_BACKEND=sqlite
SQLITE_DATABASE_PATH=./data/opportunity-radar.db

# Required only when DATABASE_BACKEND=turso. Supply secrets through the environment.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gmail OAuth files stay local and are ignored by Git.
GMAIL_OAUTH_CLIENT_SECRET_PATH=.secrets/gmail-oauth-client.json
GMAIL_TOKEN_PATH=.secrets/gmail-token.json
GMAIL_ALERT_QUERY=label:Opportunity-Radar
# Optional Gmail search used only by the read-only LinkedIn alert probe.
GMAIL_LINKEDIN_ALERT_QUERY=

# Web Push. The PUBLIC application server key is the only half a browser is
# ever shown (Phase 5.3A serves it); base64url, uncompressed P-256 point.
WEB_PUSH_VAPID_PUBLIC_KEY=

# Web Push delivery (Phase 5.3C1), server-side only. None of these may ever
# become a NEXT_PUBLIC_ variable or reach the browser bundle.
#
# The PRIVATE half of the VAPID pair: the raw P-256 scalar, base64url encoded,
# exactly as `npx web-push generate-vapid-keys` prints it. Supply it through
# the environment or a secret store — never commit it, and never log it. The
# sender refuses to start unless it derives the public key above, so a
# mismatched pair fails closed instead of collecting 401s from push services.
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact for the push services, as required by RFC 8292: a "mailto:" address
# or an "https://" URL a push service operator can reach you at.
WEB_PUSH_VAPID_SUBJECT=

# Server-side base URL of the Python API. The Next app proxies the browser to it
# from its own origin, so this must never become a NEXT_PUBLIC_ variable.
OPPORTUNITY_API_BASE_URL=http://127.0.0.1:8000
